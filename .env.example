# Copy this file to backend/.env and fill in the services you use.
# Verified against official provider docs on 2026-10-06.
# Every request tries Groq first, then Mistral on failure, then Cerebras on failure.
# Missing keys are skipped. Image requests also skip providers without a vision model.
# The first validated success stops the chain. Cache hits make no API call.
AI_PROVIDER_ORDER=groq,mistral,cerebras

GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_VISION_MODEL=qwen/qwen3.8-27b

MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-2603
MISTRAL_VISION_MODEL=mistral-small-2603

CEREBRAS_API_KEY=
CEREBRAS_MODEL=gpt-oss-120b
CEREBRAS_VISION_MODEL=

PORT=3000
ALLOWED_EXTENSION_ORIGIN=*

# Voice navigation has a separate provider policy. Keys remain backend-only.
# Transcription: Gemini first, then Speechmatics, then Sarvam on service/format failure.
# Resolution: Gemini only; no strict label match and no generated browser actions.
VOICE_STT_PROVIDER_ORDER=gemini,speechmatics,sarvam
GEMINI_API_KEY=
GEMINI_STT_MODEL=gemini-3.8-flash
GEMINI_VOICE_RESOLVER_MODEL=gemini-3.1-flash-lite
SPEECHMATICS_API_KEY=
SARVAM_API_KEY=
SARVAM_STT_MODEL=saaras:v3

# Optional accounts and preference sync. The extension build reads these values.
# Guest preferences will stay local; only signed-in users will sync with Supabase.
# Find these values in your Supabase project's Connect dialog / Settings > API Keys.
# Use the publishable key (sb_publishable_...), not a privileged secret key.
# The project URL and publishable key may be exposed to the extension.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Apply database/migrations/001_user_preferences.sql followed by 002_preference_columns.sql in Supabase SQL Editor,
# then run npm.cmd run build from extension and reload the unpacked extension.
# Run npm.cmd run check:accounts from extension for a read-only setup check.

# Email/password sign-in, signup/recovery OTP, and preference sync do not require a secret key.
# Uncomment only if a future backend administration feature needs it.
# Backend-only: never include this value in an extension build or commit it.
# SUPABASE_SECRET_KEY=

# Gmail OTP delivery is configured in the Supabase Dashboard's Auth SMTP settings,
# not in backend/.env. Supabase will generate/verify OTPs and send through Gmail.
# Enable Google 2-Step Verification and generate a Gmail App Password.
# SMTP host: smtp.gmail.com
# SMTP port: 465 (SSL) or 587 (STARTTLS)
# SMTP username and sender email: your full Gmail address
# SMTP password: your Gmail App Password, not your normal Google password
# Sender name: Bangla Accessibility Assistant
# Keep email confirmation enabled. Include {{ .Token }} in the Confirm Signup
# and Reset Password templates. Ordinary sign-in uses a password, with no OTP.
# Suggested OTP expiry: 600 seconds; retain a resend interval of at least 60 seconds.
# Enable Row Level Security on the preferences table so each user accesses only
# their own row. Guests must have no access to account preference rows.
