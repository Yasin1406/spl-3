# Copy this file to backend/.env and add one or more provider keys.
# Providers are tried from left to right. Missing keys are skipped.
AI_PROVIDER_ORDER=groq,mistral,cerebras

GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest

CEREBRAS_API_KEY=
CEREBRAS_MODEL=llama3.1-8b

PORT=3000
ALLOWED_EXTENSION_ORIGIN=*
