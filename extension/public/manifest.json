{
  "manifest_version": 3,
  "name": "Bangla Web Accessibility Assistant",
  "version": "0.1.0",
  "description": "Detects selected accessibility issues and applies reversible Bangla-friendly assistance.",
  "permissions": ["storage", "activeTab", "offscreen"],
  "minimum_chrome_version": "116",
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background/serviceWorker.js"
  },
  "action": {
    "default_title": "Bangla Accessibility Assistant",
    "default_popup": "popup/popup.html"
  },
  "options_page": "settings/settings.html",
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/keybindings.js", "content/navigationShortcut.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["<all_urls>"],
      "js": [
        "content/banglaDictionary.js",
        "content/domTranslator.js",
        "content/reasonCodes.js",
        "content/accessibilityCore.js",
        "content/adaptationRegistry.js",
        "content/liveRegion.js",
        "content/scanner.js",
        "content/keyboardRepair.js",
        "content/imageAssistant.js",
        "content/formAssistant.js",
        "content/pageContextCollector.js",
        "content/pageSummaryPlanner.js",
        "content/summaryAssistant.js",
        "content/navigationModel.js",
        "content/contentProtection.js",
        "content/noiseClassifier.js",
        "content/focusManager.js",
        "content/voiceNavigation.js",
        "content/navigationAssistant.js",
        "content/contentScript.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
